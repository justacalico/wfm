diff --git a/apps/filmcraft-web/src/hostmode.rs b/apps/filmcraft-web/src/hostmode.rs
index a839a68..96f69f5 100644
--- a/apps/filmcraft-web/src/hostmode.rs
+++ b/apps/filmcraft-web/src/hostmode.rs
@@ -54,3 +54,44 @@ pub fn project_open_ok(len: u64) -> bool {
 pub fn is_save_as(write: &str, host_document: Option<&str>, project_path: Option<&str>) -> bool {
     host_document != Some(write) && project_path == Some(write)
 }
+
+/// The `wfm:` metadata a WFM host rides in an open request's name (`wfm:{"k":…}`): the
+/// parsed object, or `None` for a plain file name.
+pub fn wfm_meta(name: &str) -> Option<serde_json::Value> {
+    serde_json::from_str::<serde_json::Value>(name.strip_prefix("wfm:")?)
+        .ok()
+        .filter(|v| v.is_object())
+}
+
+/// What a `wfm:` `media-ref` message names: the file's path in the project's tree, the URL its
+/// bytes come from (same-origin; reads fetch byte ranges), and its size in bytes. `None` for a
+/// malformed one — an open request it can't act on.
+pub fn media_ref(meta: &serde_json::Value) -> Option<(String, String, u64)> {
+    let p = meta["p"].as_str().filter(|p| !p.is_empty())?;
+    let url = meta["u"].as_str().filter(|u| !u.is_empty())?;
+    Some((p.to_string(), url.to_string(), meta["s"].as_u64().unwrap_or(0)))
+}
+
+/// What a `wfm:` `shortcuts` message carries: the user's key map as `(command, keys, panel)`
+/// triples. A key is `command` or `command@panel`; an empty value clears the binding, anything
+/// else assigns it. Malformed entries are dropped, never fatal.
+pub fn shortcut_bindings(meta: &serde_json::Value) -> Vec<(String, String, Option<String>)> {
+    meta["b"]
+        .as_object()
+        .map(|b| {
+            b.iter()
+                .filter_map(|(k, v)| {
+                    let keys = v.as_str()?;
+                    if keys.chars().count() > 100 {
+                        return None;
+                    }
+                    let (cmd, panel) = k.split_once('@').map_or((k.as_str(), None), |(c, p)| (c, Some(p.to_string())));
+                    if cmd.is_empty() {
+                        return None;
+                    }
+                    Some((cmd.to_string(), keys.to_string(), panel))
+                })
+                .collect()
+        })
+        .unwrap_or_default()
+}
