+/// A `wfm:` name is the page's control channel, not a file: `{"k":"shortcuts"}` replaces the
+/// session's key map, malformed entries are dropped, and nothing opens.
+#[test]
+fn host_shortcut_messages_set_the_key_map() {
+    let (mut app, _got) = host_app(false);
+    app.open_from_host(Some("wfm:{\"k\":\"shortcuts\",\"b\":{\"file.save\":\"Cmd+Alt+S\",\"edit.undo\":\"\",\"bad\":2,\"\":\"K\"}}"), &[]);
+    assert_eq!(app.session.wfm_keys.len(), 2);
+    assert_eq!(app.session.bound_key("file.save", Some("Cmd+S")), Some("Cmd+Alt+S"));
+    assert_eq!(app.session.bound_key("edit.undo", Some("Cmd+Z")), Some(""));
+    assert_eq!(app.session.documents().len(), 1, "the message opened no file");
+    app.open_from_host(Some("wfm:not json"), &[]);
+    assert_eq!(app.session.documents().len(), 1);
+    assert_eq!(path(&app), None, "a bogus control message named nothing");
+}
