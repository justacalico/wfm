index 04c8f37..46db504 100644
--- a/apps/filmcraft-web/src/range_fetch.rs
+++ b/apps/filmcraft-web/src/range_fetch.rs
@@ -21,8 +21,18 @@ pub const TIMEOUT_MS: i32 = 30_000;
 /// retries, so a dead server still fails the chunk in bounded time.
 pub const RETRY_DELAYS_MS: [i32; 3] = [500, 1_500, 4_500];
 
-/// Whether a response's status can serve a chunk: only `206 Partial Content` carries the asked-for
-/// `Content-Range` bytes. A `200` means a proxy dropped `Range` and the body is the entire file.
-pub fn is_chunk_status(status: u16) -> bool {
-    status == 206
+/// The bytes of `body` holding chunk `[a, b)`: the body itself when the answer is exactly the
+/// range asked for (`206`, or `200` from a host honoring the `start`/`end` params), or the
+/// `[a, b)` slice of a whole-file answer (a browser or proxy dropped the range). `Err` when the
+/// body cannot hold the chunk at all.
+pub fn chunk_bytes(body: Vec<u8>, a: u64, b: u64) -> Result<Vec<u8>, String> {
+    let want = b.saturating_sub(a) as usize;
+    if body.len() == want {
+        return Ok(body);
+    }
+    let (a, b) = (a as usize, b as usize);
+    if b <= body.len() {
+        return Ok(body[a..b].to_vec());
+    }
+    Err(format!("{} bytes cannot hold [{a}..{b})", body.len()))
 }
