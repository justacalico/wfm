+/// Register a file the host keeps on its server at `url` (same-origin, session-authenticated):
+/// a virtual entry like a Blob's, but its chunks come from HTTP range fetches — nothing is
+/// pulled until something reads it.
+pub fn register_remote(name: &str, url: &str, size: u64) -> String {
+    let clean: String = name.chars().map(|c| if c == '/' || c == '\\' { '_' } else { c }).collect();
+    FS.with(|fs| {
+        let mut fs = fs.borrow_mut();
+        let path = free_path(&fs, &clean);
+        let id = fs.next_id;
+        fs.next_id += 1;
+        fs.remote.insert(id, (Rc::from(url), size));
+        fs.entries.insert(path.clone(), Entry::Remote { id, size });
+        path
+    })
+}
