+/// The press `sc` still belongs to `id`: true while the host leaves the command unbound or keeps
+/// `sc` among its pushed bindings (`""` unbinds, ` / ` lists alternates).
+fn still(app: &SlideApp, id: &str, sc: &str) -> bool {
+    app.session.bound_key(id, Some(sc)).is_some_and(|b| b.split(" / ").any(|k| k.eq_ignore_ascii_case(sc)))
+}
+
+/// The command the host page bound to this press, if any. A rebound key beats every built-in
+/// default below; modifier-free presses still type text, so only function and navigation keys
+/// can own a binding without a modifier.
+fn bound_command(app: &SlideApp, key: egui::Key, m: Mods) -> Option<String> {
+    if app.session.wfm_keys.is_empty() {
+        return None;
+    }
+    let token = deckcraft_engine::keys::key_token(crate::app::keys::key_name(key));
+    let token = token.strip_prefix("num").map_or_else(|| token.clone(), str::to_string);
+    if !m.cmd && !m.alt {
+        let fn_key = token.strip_prefix('f').is_some_and(|n| !n.is_empty() && n.bytes().all(|b| b.is_ascii_digit()));
+        if !fn_key && !matches!(token.as_str(), "insert" | "pageup" | "pagedown") {
+            return None;
+        }
+    }
+    let hits = |id: &str| {
+        app.session.bound_key(id, Some("")).is_some_and(|b| {
+            !b.is_empty() && b.split(" / ").any(|k| deckcraft_engine::keys::shortcut_matches(k, &token, m))
+        })
+    };
+    crate::UI_COMMANDS
+        .iter()
+        .map(|c| c.0)
+        .chain(deckcraft_engine::command_specs().iter().map(|c| c.id))
+        .find(|id| hits(id))
+        .map(str::to_string)
+}
