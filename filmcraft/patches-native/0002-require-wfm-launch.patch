--- a/apps/filmcraft/src/main.rs
+++ b/apps/filmcraft/src/main.rs
@@ -115,6 +115,18 @@ fn main() -> eframe::Result {
             std::process::exit(2);
         }
     };
+    // The WFM-bundled build is only ever started by the WFM app, which passes a
+    // project file and a per-project data dir. A bare start has no checkout to
+    // save back into, so it gets a clear message instead of an editor that
+    // looks usable but silently drops everything.
+    let hosted = launch.files.iter().any(|f| args::is_project(f))
+        && (launch.data_dir.is_some() || std::env::var_os("FILMCRAFT_DATA_DIR").is_some());
+    if !hosted {
+        let msg = "FilmCraft can only be opened from WFM. Open the project from the WFM app.";
+        log::error!("{msg}");
+        let _ = rfd::MessageDialog::new().set_title("FilmCraft").set_description(msg).set_level(rfd::MessageLevel::Error).show();
+        std::process::exit(2);
+    }
     let data_root = launch.data_dir.clone().or_else(default_data_dir);
     let log_dir = data_root.as_ref().map(|d| d.join(logging::LOG_DIR));
     log::info!("FilmCraft {} ({} {})", env!("CARGO_PKG_VERSION"), std::env::consts::OS, std::env::consts::ARCH);
