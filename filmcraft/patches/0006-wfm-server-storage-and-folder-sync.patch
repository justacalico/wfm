+/// The bin under `root` matching the folder chain `dirs`, created piece by piece when
+/// missing: the id of the deepest bin (the root's own id for an empty chain).
+fn bin_for(
+    root: &filmcraft_engine::project::Bin,
+    s: &mut Session,
+    dirs: &[String],
+) -> Result<filmcraft_engine::project::BinId, String> {
+    let mut parent = root.id;
+    for name in dirs {
+        parent = match find_bin(root, parent, name) {
+            Some(id) => id,
+            None => match s.execute("file.newBin", json!({"name": name, "parent": parent.0})) {
+                Ok(v) => filmcraft_engine::project::BinId(v.get("bin").and_then(Value::as_u64).unwrap_or_default()),
+                Err(e) => return Err(e.to_string()),
+            },
+        };
+    }
+    Ok(parent)
+}
+
+/// The folder chain for `bin` under the project root (`Raw > A-Roll` → `Raw/A-Roll`), so a
+/// file imported into it lands in the matching folder on the server. Bin names get the
+/// file-name cleaning the host applies to paths (`/` and `\` already can't appear).
+pub async fn bin_folder(bin: filmcraft_engine::project::BinId) -> String {
+    let mut dirs = crate::import::on_ui(move |w, _| {
+        let mut dirs = Vec::new();
+        bin_chain(&w.app.session.project.root, bin, &mut dirs);
+        dirs
+    })
+    .await;
+    for d in &mut dirs {
+        *d = d.replace(['/', '\\', ':'], "-");
+    }
+    // The host only stores files under the project's media roots: imports taken at the
+    // panel root or in a bin outside those roots land under Raw so nothing is dropped.
+    match dirs.first().map(String::as_str) {
+        Some("Raw" | "Audio" | "Images" | "Exports") => dirs.join("/"),
+        Some(_) => format!("Raw/{}", dirs.join("/")),
+        None => "Raw".into(),
+    }
+}
+
+/// Push the names from `root` down to `target` onto `dirs`: `bin_chain(root, target, dirs)`
+/// is true when the bin exists under `root`.
+fn bin_chain(root: &filmcraft_engine::project::Bin, target: filmcraft_engine::project::BinId, dirs: &mut Vec<String>) -> bool {
+    if root.id == target {
+        return true;
+    }
+    for c in &root.children {
+        if let filmcraft_engine::project::BinEntry::Bin(b) = c {
+            dirs.push(b.name.clone());
+            if bin_chain(b, target, dirs) {
+                return true;
+            }
+            dirs.pop();
+        }
+    }
+    false
+}
