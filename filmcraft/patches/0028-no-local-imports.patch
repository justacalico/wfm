+
+/// May an entry be read, given whether the page is hosted and whether the entry's bytes exist
+/// only on this machine (`local`)? In a host page a locally picked or dropped file has no bytes
+/// anywhere else: an item pointing at it would play here and break on reopen and on the server's
+/// renders, so local entries read as missing there. Host-sent blobs and `media-ref` remotes are
+/// not local and stay readable.
+pub fn read_ok(hosted: bool, local: bool) -> bool {
+    !(hosted && local)
+}
