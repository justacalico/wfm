@@ -0,0 +1,25 @@
+//! Tests for [`range_fetch`]: the status a chunk fetch must answer and its bounded retry policy.
+
+#[path = "../../src/range_fetch.rs"]
+mod rules;
+
+use rules::{is_chunk_status, RETRY_DELAYS_MS, TIMEOUT_MS};
+
+#[test]
+fn only_a_partial_content_response_is_a_chunk() {
+    assert!(is_chunk_status(206));
+    for status in [200, 201, 204, 301, 302, 400, 403, 404, 416, 500] {
+        assert!(!is_chunk_status(status), "status {status} is not ranged content");
+    }
+}
+
+#[test]
+fn retries_back_off_and_still_fail_bounded() {
+    assert!(RETRY_DELAYS_MS.iter().all(|d| *d > 0));
+    assert!(
+        RETRY_DELAYS_MS.windows(2).all(|w| w[1] > w[0]),
+        "each retry waits longer than the last"
+    );
+    let worst = RETRY_DELAYS_MS.iter().sum::<i32>() + TIMEOUT_MS * (RETRY_DELAYS_MS.len() as i32 + 1);
+    assert!(worst < 3 * 60_000, "a dead server fails a chunk inside three minutes, not forever");
+}
