+/// Media and folders the host sends after the document opened (a refreshed file list) still
+/// belong in bins: [`restore_bins`] drains what's pending as soon as the document is up.
+fn restore_bins_if_open(bridge: &Bridge) {
+    if bridge.host_document.borrow().is_some() {
+        restore_bins();
+    }
+}
