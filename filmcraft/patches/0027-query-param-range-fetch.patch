+
+#[test]
+fn a_whole_file_answer_is_sliced() {
+    let body: Vec<u8> = (0..64).collect();
+    assert_eq!(chunk_bytes(body, 8, 16), Ok((8..16).collect()));
+}
+
+#[test]
+fn a_body_too_short_for_the_chunk_fails() {
+    assert!(chunk_bytes(vec![0; 10], 8, 16).is_err());
+    assert!(chunk_bytes(Vec::new(), 0, 16).is_err());
