+/// The project is open: every file the host sent for it that the project does not already
+/// reference is imported into bins matching its folders on the server, so the project's media
+/// shows in the Project panel instead of living only in the file table.
+fn restore_bins() {
+    let files = RESTORED.with(|r| std::mem::take(&mut *r.borrow_mut()));
+    if files.is_empty() {
+        return;
+    }
+    wasm_bindgen_futures::spawn_local(async move {
+        for (path, dirs) in files {
+            let r = crate::import::on_ui(move |w, _| {
+                let s = &mut w.app.session;
+                let referenced = s.project.items.values().any(|i| match &i.kind {
+                    filmcraft_engine::project::ItemKind::Media(m) => matches!(&m.media, filmcraft_engine::project::MediaRef::File { path: p } if *p == path),
+                    _ => false,
+                });
+                if referenced {
+                    return Ok(json!(null));
+                }
+                let mut parent = s.project.root.id;
+                for name in &dirs {
+                    parent = match find_bin(&s.project.root, parent, name) {
+                        Some(id) => id,
+                        None => match s.execute("file.newBin", json!({"name": name, "parent": parent.0})) {
+                            Ok(v) => filmcraft_engine::project::BinId(v.get("bin").and_then(Value::as_u64).unwrap_or_default()),
+                            Err(e) => return Err(e.to_string()),
+                        },
+                    };
+                }
+                s.execute("file.import", json!({"paths": [path], "bin": parent.0})).map_err(|e| e.to_string())
+            })
+            .await;
+            if let Err(e) = r {
+                crate::post(move |w, _| w.app.status(e));
+            }
+        }
+    });
+}
+
+/// The immediate child of `parent` named `name`, if it is a bin.
+fn find_bin(root: &filmcraft_engine::project::Bin, parent: filmcraft_engine::project::BinId, name: &str) -> Option<filmcraft_engine::project::BinId> {
+    root.find_bin(parent)?.children.iter().find_map(|c| match c {
+        filmcraft_engine::project::BinEntry::Bin(b) if b.name == name => Some(b.id),
+        _ => None,
+    })
+}
