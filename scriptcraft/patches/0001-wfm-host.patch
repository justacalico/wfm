+    /// WFM host mode (`?project=` in the URL): the wrapping page owns the document. It posts
+    /// `scriptcraft:open` with the doc bytes; saves post `scriptcraft:save` back for it to store.
+    fn wfm_host() -> bool {
+        web_sys::window().and_then(|w| w.location().search().ok()).is_some_and(|s| s.contains("project="))
+    }
+
+    fn wfm_post(fields: &[(&str, JsValue)]) {
+        let Some(w) = web_sys::window() else { return };
+        let Ok(Some(parent)) = w.parent() else { return };
+        let msg = js_sys::Object::new();
+        for (k, v) in fields {
+            let _ = js_sys::Reflect::set(&msg, &JsValue::from_str(k), v);
+        }
+        let origin = w.location().origin().unwrap_or_else(|_| "*".into());
+        let _ = parent.post_message(&msg, &origin);
+    }
+
+    struct WfmFiles;
+
+    impl FileHost for WfmFiles {
+        fn open(&self, _inbox: Inbox) {
+            wfm_post(&[("type", JsValue::from_str("scriptcraft:pull"))]);
+        }
+
+        fn save(&self, name: &str, bytes: Vec<u8>) {
+            wfm_post(&[
+                ("type", JsValue::from_str("scriptcraft:save")),
+                ("name", JsValue::from_str(name)),
+                ("data", JsValue::from_str(&scriptcraft_engine::b64::encode(&bytes))),
+            ]);
+        }
+    }
+
+    fn wfm_listen(inbox: Inbox, ctx: egui::Context) {
+        let Some(w) = web_sys::window() else { return };
+        let cb = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |ev: web_sys::MessageEvent| {
+            let data = ev.data();
+            if get(&data, "type").as_string().as_deref() != Some("scriptcraft:open") {
+                return;
+            }
+            let name = get(&data, "name").as_string().unwrap_or_else(|| "script.fountain".to_string());
+            let bytes = get(&data, "bytes").dyn_into::<js_sys::Uint8Array>().map(|a| a.to_vec()).unwrap_or_default();
+            if let Ok(mut q) = inbox.lock() {
+                q.push((name, bytes));
+            }
+            ctx.request_repaint();
+        });
+        let _ = w.add_event_listener_with_callback("message", cb.as_ref().unchecked_ref());
+        cb.forget();
+    }
+
+    thread_local! {
+        static LAST_DIRTY: std::cell::Cell<Option<bool>> = const { std::cell::Cell::new(None) };
+    }
+
+    fn wfm_dirty(dirty: bool) {
+        if LAST_DIRTY.with(|d| d.replace(Some(dirty))) == Some(dirty) {
+            return;
+        }
+        wfm_post(&[("type", JsValue::from_str("scriptcraft:dirty")), ("dirty", JsValue::from_bool(dirty))]);
+    }
+
