+#[test]
+fn host_pages_read_only_host_sent_media() {
+    // A picked or dropped blob is local: in a host page `file.import` (and every other command
+    // that reads it: captions, image sequences, relink) sees the path as missing, since its
+    // bytes would exist in this tab only. Outside a host it reads as before.
+    assert!(!read_ok(true, true));
+    assert!(read_ok(false, true));
+    // Host-sent media is not local: `media-ref` remotes and `filmcraft:open` blobs stay
+    // readable in host mode and out.
+    assert!(read_ok(true, false));
+    assert!(read_ok(false, false));
+}
