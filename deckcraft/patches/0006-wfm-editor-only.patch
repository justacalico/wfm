+
+/// The page's file may not exist yet: an open carrying a name and no bytes leaves the empty
+/// presentation host mode started with, now under that name, so the first Save creates the
+/// file the page asks for instead of a "Presentation1.deckcraft" it never looks at.
+#[test]
+fn a_name_with_no_bytes_names_the_empty_presentation() {
+    let (mut app, got) = host_app(false);
+    app.open_from_host(Some("boards.deckcraft"), &[]);
+    assert_eq!(app.session.documents().len(), 1);
+    assert_eq!(path(&app).as_deref(), Some("boards.deckcraft"));
+    assert!(!app.session.active().unwrap().is_dirty(), "naming alone is not an edit");
+    edit(&mut app);
+    app.save();
+    assert_eq!(calls(&got), [("boards.deckcraft".to_string(), false)], "Save writes the page's file");
+}
+
+/// A name on bytes that are not a readable presentation names the empty presentation the same
+/// way, so a Save repairs the file instead of orphaning the work under another name.
+#[test]
+fn an_unreadable_file_still_names_the_empty_presentation() {
+    let (mut app, got) = host_app(false);
+    app.open_from_host(Some("boards.deckcraft"), b"not a presentation");
+    assert_eq!(app.session.documents().len(), 1);
+    assert_eq!(path(&app).as_deref(), Some("boards.deckcraft"));
+    edit(&mut app);
+    app.save();
+    assert_eq!(calls(&got), [("boards.deckcraft".to_string(), false)]);
+}
+
+/// A hosted page has no File tab: the Backstage never opens, the theme is the page's, and the
+/// Design Ideas pane does not exist.
+#[test]
+fn a_hosted_app_has_no_backstage_theme_switch_or_design_ideas() {
+    let (mut app, _got) = host_app(false);
+    app.open_from_host(Some("deck.pptx"), &pptx(1));
+    app.open_backstage(crate::backstage::Page::Home);
+    assert!(app.backstage.is_none(), "the File tab's view is a no-op in host mode");
+    app.run("app.backstage", json!({"page": "home"})).unwrap();
+    assert!(app.backstage.is_none());
+    assert!(app.run("view.dark", json!({})).is_err(), "the page picks the theme");
+    assert!(app.run("view.pane", json!({"pane": "designer"})).is_err(), "the page has no Design Ideas");
+    assert!(app.ui.pane.is_none());
+}
