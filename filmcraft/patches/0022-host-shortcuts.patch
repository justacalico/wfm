+#[test]
+fn wfm_meta_reads_the_hosts_json_and_ignores_plain_names() {
+    assert!(wfm_meta("Trailer.fcproj").is_none());
+    assert!(wfm_meta("wfm:not-json").is_none());
+    assert!(wfm_meta("wfm:3").is_none(), "a scalar is not a message");
+    let m = wfm_meta(r#"wfm:{"k":"doc","n":"x.fcproj"}"#).unwrap();
+    assert_eq!(m["k"], "doc");
+}
+
+#[test]
+fn media_refs_need_a_path_and_a_url() {
+    let m = wfm_meta(r#"wfm:{"k":"media-ref","p":"Raw/a.mp4","u":"/api/p1/download?path=Raw%2Fa.mp4","s":12}"#).unwrap();
+    assert_eq!(media_ref(&m), Some(("Raw/a.mp4".into(), "/api/p1/download?path=Raw%2Fa.mp4".into(), 12u64)));
+    assert!(media_ref(&serde_json::json!({"k": "media-ref", "p": "", "u": "/x"})).is_none());
+    assert!(media_ref(&serde_json::json!({"k": "media-ref", "p": "a.mp4"})).is_none());
+    let (p, u, s) = media_ref(&serde_json::json!({"p": "a.mp4", "u": "/x"})).unwrap();
+    assert_eq!((p.as_str(), u.as_str(), s), ("a.mp4", "/x", 0), "a missing size reads as empty");
+}
+
+#[test]
+fn shortcut_bindings_parse_the_key_map() {
+    let m = serde_json::json!({"k": "shortcuts", "b": {"edit.undo": "Alt+Q", "file.newBin@Project": "", "": "K", "edit.redo": 3}});
+    assert_eq!(
+        shortcut_bindings(&m),
+        vec![
+            ("edit.undo".to_string(), "Alt+Q".to_string(), None),
+            ("file.newBin".to_string(), String::new(), Some("Project".to_string())),
+        ]
+    );
+    assert!(shortcut_bindings(&serde_json::json!({"k": "shortcuts"})).is_empty());
+    assert!(shortcut_bindings(&serde_json::json!({"k": "shortcuts", "b": "x"})).is_empty());
+}
