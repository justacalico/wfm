+//! Remote-media range fetch policy (pure, so it is tested natively in `tests/it/range_fetch.rs`;
+//! the fetches themselves live in [`crate::fs`]).
+//!
+//! A remote entry's bytes are read one chunk at a time from the host's ranged download endpoint.
+//! Three failure shapes used to look identical to the reader — "still loading" forever:
+//!
+//! - a `200` answer (some proxy dropped the `Range` header) streams the *whole* file, which for
+//!   a gigabyte clip never finishes;
+//! - a stalled fetch never resolves, pinning the chunk `inflight`;
+//! - a transient failure marked the chunk dead with no retry.
+//!
+//! The constants and the status check here bound every attempt and let the fetch loop retry
+//! before the chunk is written off.
+
+/// Milliseconds one ranged fetch may take before it is aborted. A chunk fetch is a few MiB from a
+/// same-origin host, so half a minute is generous; the bound exists because a stalled request
+/// would otherwise never resolve.
+pub const TIMEOUT_MS: i32 = 30_000;
+
+/// Delays (ms) slept before each retry of a failed ranged fetch: one initial try plus this many
+/// retries, so a dead server still fails the chunk in bounded time.
+pub const RETRY_DELAYS_MS: [i32; 3] = [500, 1_500, 4_500];
+
+/// Whether a response's status can serve a chunk: only `206 Partial Content` carries the asked-for
+/// `Content-Range` bytes. A `200` means a proxy dropped `Range` and the body is the entire file.
+pub fn is_chunk_status(status: u16) -> bool {
+    status == 206
+}
