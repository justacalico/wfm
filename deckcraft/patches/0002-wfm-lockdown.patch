+
+/// The page owns the file lifecycle: new, open, close, revert and the local file dialogs are
+/// refused, while host-sent files still open and insert commands keep working.
+#[test]
+fn a_hosted_app_refuses_local_file_commands() {
+    let (mut app, _got) = host_app(false);
+    app.open_from_host(Some("deck.pptx"), &pptx(1));
+    for id in ["file.new", "file.close", "file.revert", "file.recovery.open", "app.openDialog", "app.closePresentation"] {
+        assert!(app.run(id, json!({})).is_err(), "{id} must be refused in host mode");
+    }
+    assert_eq!(app.session.documents().len(), 1, "the host document stays open");
+}
+
+/// A dropped presentation can't open in host mode; a dropped picture still inserts into the
+/// page's document.
+#[test]
+fn a_hosted_drop_inserts_media_but_never_opens_a_file() {
+    let (mut app, _got) = host_app(false);
+    app.open_from_host(Some("deck.pptx"), &pptx(1));
+    app.open_or_insert_bytes("other.pptx", &pptx(2));
+    assert_eq!(app.session.documents().len(), 1, "a dropped presentation is refused");
+    let png = [0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];
+    app.open_or_insert_bytes("a.png", &png);
+    assert!(app.status.is_none_or(|(m, _)| !m.contains("keeps")), "media still inserts");
+}
