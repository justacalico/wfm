diff --git a/apps/scriptcraft-web/src/main.rs b/apps/scriptcraft-web/src/main.rs
index cf42d01..44e8089 100644
--- a/apps/scriptcraft-web/src/main.rs
+++ b/apps/scriptcraft-web/src/main.rs
@@ -385,7 +385,22 @@ mod web {
                         } else {
                             ScriptApp::new(Session::sample())
                         };
-                        app.dark = cc.egui_ctx.system_theme() == Some(egui::Theme::Dark);
+                        // The host page owns the theme: `&theme=` (light/dark/oled/system) picks
+                        // it; no host word means the OS choice, as before.
+                        let theme = web_sys::window()
+                            .and_then(|w| w.location().search().ok())
+                            .and_then(|s| web_sys::UrlSearchParams::new_with_str(&s).ok())
+                            .and_then(|p| p.get("theme"));
+                        app.dark = match theme.as_deref() {
+                            Some("light") => false,
+                            Some("dark") | Some("oled") => true,
+                            _ => cc.egui_ctx.system_theme() == Some(egui::Theme::Dark),
+                        };
+                        app.prefs.appearance.theme = if app.dark {
+                            scriptcraft_ui_egui::persist::Theme::Dark
+                        } else {
+                            scriptcraft_ui_egui::persist::Theme::Light
+                        };
                         let files: Box<dyn FileHost> = if host_mode {
                             wfm_listen(app.inbox.clone(), cc.egui_ctx.clone());
                             wfm_post(&[("type", JsValue::from_str("scriptcraft:ready"))]);
