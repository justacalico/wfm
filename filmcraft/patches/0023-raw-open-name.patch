+/// A `filmcraft:open` message as the host sent it: the raw `name` (a `wfm:` metadata name
+/// survives whole — the crate's `file_name` cleaning is the basename cut this bypasses) and its
+/// `file` or `bytes` payload, `None` when either is missing.
+fn open_message(data: &JsValue) -> Option<(String, FileData)> {
+    if js_sys::Reflect::get(data, &"type".into()).ok()?.as_string().as_deref() != Some("filmcraft:open") {
+        return None;
+    }
+    let name = js_sys::Reflect::get(data, &"name".into()).ok().and_then(|v| v.as_string()).unwrap_or_default();
+    let file = js_sys::Reflect::get(data, &"file".into()).ok()?;
+    if let Some(blob) = file.dyn_ref::<web_sys::Blob>() {
+        return Some((name, FileData::Blob(blob.clone())));
     }
+    let bytes = js_sys::Reflect::get(data, &"bytes".into()).ok()?;
+    let data = if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        FileData::Bytes(array.clone())
+    } else if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        FileData::Bytes(js_sys::Uint8Array::new(&bytes))
+    } else {
+        return None;
+    };
+    Some((name, data))
 }
 
