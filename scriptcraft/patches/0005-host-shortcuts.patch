+/// File commands and find have a `ui.*` twin: the engine default and the host binding
+/// live under different ids, so a rebind must hide the twin's default too.
+fn ui_alias(id: &str) -> Option<&'static str> {
+    Some(match id {
+        "file.save" => "ui.save",
+        "file.saveAs" => "ui.saveAs",
+        "file.exportPdf" => "ui.exportPdf",
+        "ui.save" => "file.save",
+        "ui.saveAs" => "file.saveAs",
+        "ui.exportPdf" => "file.exportPdf",
+        "edit.find" => "ui.find",
+        "ui.find" => "edit.find",
+        _ => return None,
+    })
+}
+
+/// The binding the WFM host set for `id` (or its `ui.*` twin), if any.
+pub(crate) fn wfm_bind<'a>(app: &'a ScriptApp, id: &str) -> Option<&'a str> {
+    app.wfm_keys
+        .get(id)
+        .or_else(|| ui_alias(id).and_then(|a| app.wfm_keys.get(a)))
+        .map(String::as_str)
+}
