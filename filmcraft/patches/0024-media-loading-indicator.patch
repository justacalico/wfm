+/// Clears [`MEDIA_SYNC`], the media panel's "Loading media…" marker, when the restore pass
+/// ends on any path, then repaints so the real item count replaces it.
+struct MediaSyncGuard;
+impl Drop for MediaSyncGuard {
+    fn drop(&mut self) {
+        MEDIA_SYNC.fetch_sub(1, Ordering::Relaxed);
+        crate::repaint();
+    }
+}
