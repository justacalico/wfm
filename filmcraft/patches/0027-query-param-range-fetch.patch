+fn an_exact_chunk_answer_is_used_as_is() {
+    let body: Vec<u8> = (0..16).collect();
+    assert_eq!(chunk_bytes(body.clone(), 0, 16), Ok(body));
+    let tail: Vec<u8> = (0..7).collect();
+    assert_eq!(chunk_bytes(tail.clone(), 9, 16), Ok(tail), "a tail chunk is shorter");
